{
  "name": "renaiss_ticket",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/production-server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch:ledger": "node scripts/fetch-lucky-draw-ledger.mjs",
    "watch:ledger": "node scripts/watch-lucky-draw-ledger.mjs --interval-minutes 60",
    "watch:ledger:15m": "node scripts/watch-lucky-draw-ledger.mjs --interval-minutes 15",
    "fetch:ledger:prod": "node scripts/fetch-lucky-draw-ledger.mjs --cache-dir /data/lucky-draw/cache --out /data/lucky-draw/lucky-draw-ledger.json",
    "backup:data": "node scripts/backup-lucky-draw-data.mjs",
    "contract:compile": "hardhat compile",
    "contract:dry-run": "node scripts/contract-dry-run.mjs",
    "contract:deploy:check": "node scripts/deploy-lucky-draw.mjs",
    "contract:deploy:bsc": "node scripts/deploy-lucky-draw.mjs --broadcast",
    "contract:deploy:testnet:check": "node scripts/deploy-lucky-draw.mjs --env-file .env.deploy.testnet.local",
    "contract:deploy:testnet": "node scripts/deploy-lucky-draw.mjs --env-file .env.deploy.testnet.local --broadcast",
    "contract:roles:check": "node scripts/configure-lucky-draw-roles.mjs",
    "contract:roles": "node scripts/configure-lucky-draw-roles.mjs --broadcast",
    "contract:roles:testnet:check": "node scripts/configure-lucky-draw-roles.mjs --env-file .env.deploy.testnet.local",
    "contract:roles:testnet": "node scripts/configure-lucky-draw-roles.mjs --env-file .env.deploy.testnet.local --broadcast",
    "contract:round:testnet": "node scripts/run-lucky-draw-round.mjs --env-file .env.deploy.testnet.local",
    "wallet:create": "node scripts/create-deployment-wallet.mjs"
  },
  "dependencies": {
    "ethers": "^6.16.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simplex-noise": "^4.0.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "hardhat": "^3.7.0",
    "solc": "^0.8.35",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
